# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Public HTTPS base URL in production (use an HTTPS tunnel URL for local Creem testing).
PUBLIC_APP_URL="https://shop.example.com"

# LANKABUY AUTOMATED SUPPLIER GATEWAY (Server-Side Only)
# API Key for authenticating with the LankaBuy automated fulfillment dispatch network
LANKABUY_SUPPLIER_API_KEY="replace-with-supplier-api-key"
# Endpoint for LankaBuy supplier fulfillment gateway
LANKABUY_SUPPLIER_ENDPOINT="https://gateway.lankabuy.lk/v1/fulfillment"

# ALIEXPRESS OPEN PLATFORM API CREDENTIALS (Server-Side Only)
# Never expose these keys to the client-side browser
ALIEXPRESS_APP_KEY="replace-with-aliexpress-app-key"
ALIEXPRESS_APP_SECRET="replace-with-aliexpress-app-secret"
ALIEXPRESS_TRACKING_ID="replace-with-aliexpress-tracking-id"

# CJ DROPSHIPPING API CREDENTIALS (Server-Side Only)
# Access Token / API Key from CJ Dropshipping Developer Center (My CJ > Settings > API)
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_DROPSHIPPING_API_KEY=
CJ_DROPSHIPPING_ACCESS_TOKEN=
CJ_EMAIL=
CJ_DROPSHIPPING_EMAIL=

# Creem.io (MOR) API Keys
CREEM_API_KEY=
CREEM_GENERIC_PRODUCT_ID=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
CREEM_WEBHOOK_URL="https://shop.example.com/api/webhooks/creem"

# STORE PROFIT MARGIN & EXCHANGE RATE CONFIGURATION
PROFIT_MARGIN_PERCENT=25
DEFAULT_PROFIT_MARGIN_PERCENT=25
CBSL_EXCHANGE_RATE_API_URL="https://api.frankfurter.dev/v2/rate/USD/LKR?providers=CBSL"
MANUAL_USD_LKR_RATE=

# SECURITY & AUTHENTICATION (Server-Side Only)
ADMIN_ALLOWED_EMAIL=admin@example.com
JWT_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=

# Firebase Web SDK (Vite exposes only variables prefixed with VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Firebase Admin SDK (server-only; prefer Application Default Credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_FIRESTORE_DATABASE_ID=default
